# Copy to .env and replace ALL CHANGE_ME values locally; NEVER commit .env.
PORT=3000
POSTGRES_DB=road_damage
POSTGRES_USER=road_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgres://road_user:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/road_damage
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=180d
MANAGER_EMAIL=manager@example.invalid
MANAGER_PASSWORD=CHANGE_ME_STRONG_MANAGER_PASSWORD
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_SECRET
MINIO_BUCKET=report-images
MINIO_PUBLIC_URL=http://localhost:9000
